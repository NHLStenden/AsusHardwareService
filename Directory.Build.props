<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Company>NHL Stenden</Company>
    <Product>ASUS Hardware Service</Product>
    <Description>Lightweight Windows service for selected ASUS laptop hardware controls.</Description>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
